{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:best-practices",
    ":maintainLockFilesWeekly",
    "docker:enableMajor",
    "helpers:pinGitHubActionDigests",
    "group:monorepos",
    "group:recommended"
  ],
  "configMigration": true,
  "forkProcessing": "disabled",
  "platformCommit": "disabled",
  "automerge": false,
  "internalChecksAsSuccess": true,
  "recreateWhen": "always",
  "rebaseLabel": "rebase",
  "keepUpdatedLabel": "rebase-always",
  "stopUpdatingLabel": "stop-updating",
  "semanticCommits": "enabled",
  "rangeStrategy": "bump",
  "separateMultipleMajor": true,
  "fetchChangeLogs": "branch",
  "gitIgnoredAuthors": ["tim275@users.noreply.github.com"],
  "assigneesFromCodeOwners": true,
  "timezone": "Europe/Berlin",
  "prConcurrentLimit": 0,
  "prHourlyLimit": 0,
  "major": {
    "dependencyDashboardApproval": true
  },
  "dependencyDashboard": {
    "enabled": true,
    "title": "🔄 Renovate Dashboard",
    "labels": ["renovate"],
    "osvVulnerabilitySummary": "all"
  },
  "osvVulnerabilityAlerts": true,
  "labels": ["renovate"],
  "prHeader": "📦 Dependency Update — review CHANGELOG before merge.",
  "prBodyColumns": ["Package", "Update", "Type", "New value", "Pending", "References"],
  "vulnerabilityAlerts": {
    "enabled": true,
    "labels": ["renovate", "security"],
    "schedule": ["at any time"],
    "automerge": false,
    "minimumReleaseAge": "0 days",
    "prCreation": "immediate"
  },
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["before 5am on sunday"]
  },
  "kubernetes": {
    "managerFilePatterns": ["/kubernetes/.+\\.ya?ml$/"]
  },
  "crossplane": {
    "managerFilePatterns": ["/^kubernetes/platform/automation/crossplane/overlays/[^/]+/(functions|providers|configuration)\\.yaml$/"]
  },
  "ignorePaths": ["**/charts/**", "**/rendered/**"],
  "packageRules": [
    {
      "description": "Automerge: Minor, Patch und Digest, wenn die Checks gruen sind. Jede Regel mit manual-review-required nimmt ihre Pakete wieder aus",
      "matchUpdateTypes": ["minor", "patch", "digest"],
      "automerge": true
    },
    {
      "description": "rendered/ nach Chart-Update neu erzeugen",
      "matchManagers": ["kustomize", "crossplane", "helm-values"],
      "matchDatasources": ["helm", "docker"],
      "matchFileNames": [
        "kubernetes/infrastructure/cluster/descheduler/overlays/*/kustomization.yaml",
        "kubernetes/infrastructure/cluster/reloader/overlays/*/kustomization.yaml",
        "kubernetes/infrastructure/monitoring/blackbox-exporter/overlays/*/kustomization.yaml",
        "kubernetes/infrastructure/network/external-dns/overlays/*/kustomization.yaml",
        "kubernetes/infrastructure/network/sail-operator/overlays/*/kustomization.yaml",
        "kubernetes/infrastructure/security/cert-manager/overlays/*/kustomization.yaml",
        "kubernetes/infrastructure/security/openbao-operator/overlays/*/kustomization.yaml",
        "kubernetes/infrastructure/security/vault-config-operator/overlays/*/kustomization.yaml",
        "kubernetes/infrastructure/storage/rook-ceph/overlays/*/kustomization.yaml",
        "kubernetes/platform/automation/crossplane/overlays/*/kustomization.yaml",
        "kubernetes/platform/automation/crossplane/overlays/*/functions.yaml",
        "kubernetes/platform/automation/crossplane/overlays/*/configuration.yaml",
        "kubernetes/platform/automation/crossview/overlays/*/kustomization.yaml",
        "kubernetes/platform/automation/crossview/overlays/*/values.yaml",
        "kubernetes/platform/automation/renovate/overlays/*/kustomization.yaml",
        "kubernetes/platform/data/cloudnative-pg/overlays/*/kustomization.yaml",
        "kubernetes/platform/data/redis/overlays/*/kustomization.yaml",
        "kubernetes/platform/delivery/argo-rollouts/overlays/*/kustomization.yaml",
        "kubernetes/platform/delivery/keda/overlays/*/kustomization.yaml",
        "kubernetes/platform/observability/eck/overlays/*/kustomization.yaml",
        "kubernetes/platform/observability/grafana-operator/overlays/*/kustomization.yaml",
        "kubernetes/platform/observability/opentelemetry-operator/overlays/*/kustomization.yaml"
      ],
      "postUpgradeTasks": {
        "commands": [
          "kustomize build {{{packageFileDir}}} --enable-helm --load-restrictor=LoadRestrictionsNone -o {{{replace '/overlays/' '/rendered/' packageFileDir}}}/manifests.yaml"
        ],
        "installTools": {
          "kustomize": { "version": "5.8.1" },
          "helm": { "version": "4.2.1" }
        },
        "fileFilters": ["**/rendered/*/manifests.yaml"],
        "executionMode": "update"
      }
    },
    {
      "description": "Grafana-Jaeger-Datenquelle braucht /api/services, ab Jaeger 2.21 entfernt (grafana/grafana-jaeger-datasource#87)",
      "matchPackageNames": ["docker.io/jaegertracing/jaeger"],
      "allowedVersions": "<2.21.0"
    },
    {
      "description": "Talos, Kubernetes und Talos-Systemwerkzeuge: Upgrade per talosctl, PR nur nach Freigabe im Dashboard",
      "matchPackageNames": [
        "/siderolabs/talos/",
        "/siderolabs/installer/",
        "/siderolabs/imager/",
        "/siderolabs/kubelet/",
        "/^kubernetes$/",
        "/^k8s.io/",
        "/registry.k8s.io/kube-/",
        "/etcd-io/etcd/",
        "/cri-tools/",
        "/cni-plugins/",
        "/containerd/"
      ],
      "dependencyDashboardApproval": true,
      "automerge": false,
      "addLabels": ["manual-review-required", "talosctl"]
    },
    {
      "description": "Versionsfelder in den Talos-tfvars: nur nach Freigabe im Dashboard",
      "matchFileNames": ["tofu/stacks/cluster/talos_cluster.auto.tfvars", "tofu/stacks/cluster/talos_image.auto.tfvars"],
      "matchDepNames": ["kubernetes_version", "talos_machine_config_version"],
      "dependencyDashboardApproval": true,
      "automerge": false,
      "addLabels": ["manual-review-required", "talosctl"]
    },
    {
      "description": "Tofu-Provider: Lock-Files per tofu providers lock, PR nur nach Freigabe",
      "matchDatasources": ["terraform-provider"],
      "dependencyDashboardApproval": true,
      "automerge": false,
      "addLabels": ["manual-review-required", "tofu-lock"]
    },
    {
      "description": "Ceph-Image nur zusammen mit dem rook-ceph-Chart (Rook-Matrix)",
      "matchPackageNames": ["/ceph/ceph/"],
      "minimumReleaseAge": "21 days",
      "automerge": false,
      "addLabels": ["manual-review-required", "rook-matrix"]
    },
    {
      "description": "required_version ist die Untergrenze fuer OpenTofu, Renovate schlaegt dafuer Terraform-Versionen vor",
      "matchManagers": ["terraform"],
      "matchDepTypes": ["required_version"],
      "enabled": false
    },
    {
      "description": "setup-opentofu liest die Versionen aus get.opentofu.org/tofu/api.json, dort fehlt 1.12.7",
      "matchDepNames": ["opentofu"],
      "matchDepTypes": ["uses-with"],
      "allowedVersions": "!/^v?1\\.12\\.7$/"
    },
    {
      "description": "docker:pinDigests scheitert an version:-Feldern, Digests stehen direkt in den Manifesten",
      "matchPackageNames": ["*"],
      "pinDigests": false
    },
    {
      "description": "Grafana-Helm-Charts",
      "matchDatasources": ["helm"],
      "matchPackageNames": ["tempo-distributed", "grafana", "promtail", "grafana-operator", "mimir-distributed"],
      "registryUrls": ["https://grafana.github.io/helm-charts"]
    },
    {
      "description": "GROUP: Cilium project (must upgrade together)",
      "groupName": "cilium",
      "matchPackageNames": ["/cilium/cilium/", "/cilium/hubble/", "/cilium/cilium-cli/"]
    },
    {
      "description": "GROUP: Argo project",
      "groupName": "argo-project",
      "matchPackageNames": [
        "/argoproj/argo-cd/",
        "/argoproj/argo-rollouts/",
        "/argoproj/argo-events/",
        "/argoproj/argo-workflows/",
        "/argo-cd$/",
        "/argo-rollouts$/"
      ]
    },
    {
      "description": "GROUP: Rook+Ceph (same project, must upgrade together)",
      "groupName": "rook-ceph",
      "matchPackageNames": ["/rook/", "/ceph/"]
    },
    {
      "description": "GROUP: Velero suite (plugin-coupled)",
      "groupName": "velero-suite",
      "matchPackageNames": ["/velero/velero/", "/velero/velero-plugin-/", "/vmware-tanzu/velero/"]
    },
    {
      "description": "GROUP: CloudNativePG suite",
      "groupName": "cnpg-suite",
      "matchPackageNames": ["/cloudnative-pg/cloudnative-pg/", "/cloudnative-pg/plugin-barman-cloud/", "/cloudnative-pg/cnpg-i/"]
    },
    {
      "description": "GROUP: Strimzi Kafka",
      "groupName": "strimzi-kafka",
      "matchPackageNames": ["/strimzi/strimzi-kafka-operator/", "/strimzi/operator/"]
    },
    {
      "description": "GROUP: Keycloak",
      "groupName": "keycloak",
      "matchPackageNames": ["/keycloak/keycloak/", "/keycloak/keycloak-operator/", "/keycloak-operator$/"]
    },
    {
      "description": "GROUP: cert-manager mit CRDs",
      "groupName": "cert-manager",
      "matchPackageNames": ["/^cert-manager$/", "cert-manager/cert-manager"]
    },
    {
      "description": "GROUP: external-secrets mit CRDs",
      "groupName": "external-secrets",
      "matchPackageNames": ["/^external-secrets$/", "external-secrets/external-secrets"]
    },
    {
      "description": "GROUP: Envoy Gateway mit CRDs",
      "groupName": "envoy-gateway",
      "matchPackageNames": ["/^gateway-helm$/", "/^gateway-crds-helm$/"]
    },
    {
      "description": "GROUP: kube-prometheus-stack mit CRDs",
      "groupName": "kube-prometheus-stack",
      "matchPackageNames": ["/^kube-prometheus-stack$/", "/^prometheus-operator-crds$/"]
    },
    {
      "description": "GROUP: external-snapshotter, Controller mit CRDs und RBAC",
      "groupName": "external-snapshotter",
      "matchPackageNames": ["kubernetes-csi/external-snapshotter", "/sig-storage/snapshot-controller/"]
    },
    {
      "description": "GROUP: alpine/k8s steht mit und ohne docker.io im Repo",
      "groupName": "alpine-k8s",
      "matchPackageNames": ["alpine/k8s", "docker.io/alpine/k8s"]
    },
    {
      "description": "GROUP: GitHub Actions",
      "groupName": "github-actions",
      "matchManagers": ["github-actions"]
    },
    {
      "description": "digest",
      "matchUpdateTypes": ["digest"],
      "minimumReleaseAge": "0 days",
      "addLabels": ["digest"]
    },
    {
      "description": "patch",
      "matchUpdateTypes": ["patch"],
      "minimumReleaseAge": "2 days",
      "addLabels": ["patch"]
    },
    {
      "description": "minor",
      "matchUpdateTypes": ["minor"],
      "minimumReleaseAge": "5 days",
      "addLabels": ["minor"]
    },
    {
      "description": "major",
      "matchUpdateTypes": ["major"],
      "minimumReleaseAge": "7 days",
      "addLabels": ["major", "manual-review-required"]
    },
    {
      "description": "Staging: eigener Branch und eigener PR",
      "matchFileNames": ["kubernetes/**/overlays/staging/**"],
      "additionalBranchPrefix": "staging-",
      "commitMessageSuffix": "(staging)",
      "addLabels": ["staging"]
    },
    {
      "description": "Prod",
      "matchFileNames": ["kubernetes/**/overlays/prod/**"],
      "commitMessageSuffix": "(prod)",
      "addLabels": ["prod"]
    },
    {
      "description": "base und components gelten fuer jede Umgebung",
      "matchFileNames": ["kubernetes/**/base/**", "kubernetes/**/components/**"],
      "commitMessageSuffix": "(base)",
      "addLabels": ["base"]
    },
    {
      "description": "Prod folgt Staging: fruehestens 7 Tage nach dem Release, erst mergen wenn Staging damit laeuft",
      "matchFileNames": [
        "kubernetes/infrastructure/security/openbao/overlays/prod/**",
        "kubernetes/infrastructure/security/openbao-config/overlays/prod/**",
        "kubernetes/infrastructure/security/openbao-operator/overlays/prod/**",
        "kubernetes/infrastructure/security/vault-config-operator/overlays/prod/**"
      ],
      "minimumReleaseAge": "7 days",
      "prCreation": "not-pending"
    },
    {
      "description": "ghcr, quay, registry.k8s.io liefern keinen Release-Zeitstempel",
      "matchDatasources": ["docker"],
      "minimumReleaseAgeBehaviour": "timestamp-optional"
    },
    {
      "description": "Kritische Infrastruktur: 21 Tage, nie automatisch (Strimzi 0.51 brach am 16.05.2026 Kafka). Chart-Namen ohne Pfad matchen nur mit ^…$",
      "matchPackageNames": [
        "/cilium/cilium/",
        "/cert-manager/cert-manager/",
        "/cloudnative-pg/cloudnative-pg/",
        "/argoproj/argo-cd/",
        "/kyverno/kyverno/",
        "/keycloak/keycloak/",
        "/strimzi/strimzi-kafka-operator/",
        "/rook/rook/",
        "/^cilium$/",
        "/^cert-manager$/",
        "/^cloudnative-pg$/",
        "/^argo-cd$/",
        "/^kyverno$/",
        "/^strimzi-kafka-operator$/",
        "/^rook-ceph$/",
        "/gateway-helm$/",
        "/gateway-crds-helm$/",
        "/^ceph-csi-drivers$/",
        "/coredns/coredns/",
        "/^tetragon$/",
        "/openbao/",
        "/external-secrets/",
        "/^eck-operator$/",
        "/^plugin-barman-cloud$/",
        "/^velero$/",
        "/velero/velero-plugin-/",
        "/kubevirt/kubevirt/",
        "/^harbor$/"
      ],
      "matchUpdateTypes": ["patch", "minor", "major"],
      "minimumReleaseAge": "21 days",
      "automerge": false,
      "addLabels": ["critical-infrastructure", "manual-review-required"]
    },
    {
      "description": "OpenTofu: nie automatisch, der State haengt an der Version",
      "matchDepNames": ["opentofu", "opentofu/opentofu"],
      "automerge": false,
      "addLabels": ["manual-review-required"]
    },
    {
      "description": "Crossplane-Vorlagen in prod: von Hand mergen, wenn staging damit laeuft",
      "matchPackageNames": ["ghcr.io/tim275/talos-homelab/crossplane-apis"],
      "matchFileNames": ["kubernetes/**/overlays/prod/**"],
      "automerge": false,
      "addLabels": ["manual-review-required"]
    },
    {
      "description": "n8n: Version aus den GitHub-Releases, Pre-Releases (Beta) gelten dort als instabil und werden nicht vorgeschlagen",
      "matchDatasources": ["github-releases"],
      "matchPackageNames": ["n8n-io/n8n"],
      "extractVersion": "^n8n@(?<version>.+)$"
    },
    {
      "description": "Images von GHCR/Quay: Version aus den GitHub-Releases (Zeitstempel, Pre-Releases gelten als instabil)",
      "matchDatasources": ["github-releases"],
      "matchPackageNames": ["louislam/uptime-kuma", "prometheus-pve/prometheus-pve-exporter", "open-telemetry/opentelemetry-collector-releases", "jaegertracing/jaeger", "openbao/openbao", "lldap/lldap"],
      "extractVersion": "^v?(?<version>.+)$"
    },
    {
      "description": "Diese Images nicht über die Registry aktualisieren, GHCR und Quay liefern keine Zeitstempel",
      "matchDatasources": ["docker"],
      "matchPackageNames": ["ghcr.io/n8n-io/n8n", "ghcr.io/n8n-io/runners", "ghcr.io/louislam/uptime-kuma", "ghcr.io/prometheus-pve/prometheus-pve-exporter", "ghcr.io/open-telemetry/opentelemetry-collector-releases/opentelemetry-collector-contrib", "quay.io/jaegertracing/jaeger", "ghcr.io/openbao/openbao", "ghcr.io/lldap/lldap"],
      "enabled": false
    },
    {
      "description": "Keycloak patch: Sicherheitsfixes nicht 21 Tage warten lassen",
      "matchPackageNames": ["/keycloak/keycloak/", "/keycloak/keycloak-operator/", "/keycloak-operator$/"],
      "matchUpdateTypes": ["patch"],
      "minimumReleaseAge": "2 days"
    },
    {
      "description": "Datenbanken: 14 Tage, nie automatisch",
      "matchPackageNames": ["/postgresql/", "/postgres/", "/mysql/", "/mongodb/", "/redis/", "/elasticsearch/", "/influxdb/", "/^apache/kafka$/"],
      "matchUpdateTypes": ["patch", "minor", "major"],
      "minimumReleaseAge": "14 days",
      "automerge": false,
      "addLabels": ["manual-review-required", "stateful-database"]
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "# renovate: <datasource>=<depName> [registry=…] [versioning=…]",
      "managerFilePatterns": ["/\\.tf$/", "/\\.tofu$/", "/\\.tftpl$/", "/\\.tfvars$/", "/\\.yaml$/", "/\\.yml$/", "/\\.sh$/"],
      "matchStrings": [
        "(?<currentValue>[\\w+\\.\\-]*)['\",;]*\\s*#\\s*renovate:\\s*(?<datasource>\\S+)=(?<depName>\\S+)(?:\\s+registry=(?<registryUrl>\\S+))?(?:\\s+versioning=(?<versioning>\\S+))?"
      ]
    },
    {
      "customType": "regex",
      "description": "Images in tofu/",
      "managerFilePatterns": ["/tofu/.*\\.(yaml|yml|tftpl)$/"],
      "matchStrings": ["image:\\s*(?<depName>(?:[\\w.-]+\\/)?[\\w.-]+\\/[\\w.-]+):(?<currentValue>v?[\\w.-]+)"],
      "datasourceTemplate": "docker"
    },
    {
      "customType": "regex",
      "description": "lldap: Version vor dem Suffix -alpine-rootless",
      "managerFilePatterns": ["/^kubernetes/platform/identity/lldap/overlays/[^/]+/kustomization\\.yaml$/"],
      "matchStrings": ["newTag: (?<currentValue>v[\\d.]+)-alpine-rootless"],
      "depNameTemplate": "lldap/lldap",
      "datasourceTemplate": "github-releases"
    },
    {
      "customType": "regex",
      "description": "Images in crossplane/",
      "managerFilePatterns": ["/^crossplane/apis/.+\\.yaml$/"],
      "matchStrings": ["image:\\s*(?<depName>[\\w.-]+(?:\\/[\\w.-]+)+):(?<currentValue>[\\w.-]+)@(?<currentDigest>sha256:[a-f0-9]{64})"],
      "datasourceTemplate": "docker"
    },
    {
      "customType": "regex",
      "description": "Keycloak-Operator: Release-Dateien aus keycloak-k8s-resources",
      "managerFilePatterns": ["/^kubernetes/platform/identity/keycloak-operator/overlays/[^/]+/kustomization\\.yaml$/"],
      "matchStrings": [
        "https://raw\\.githubusercontent\\.com/(?<depName>keycloak/keycloak-k8s-resources)/(?<currentValue>[\\d.]+)/"
      ],
      "datasourceTemplate": "github-tags"
    },
    {
      "customType": "regex",
      "description": "Release-URLs in Kustomizations",
      "managerFilePatterns": [
        "/^kubernetes/argocd/crds/kustomization\\.yaml$/",
        "/^kubernetes/.+/overlays/[^/]+/(.+/)?kustomization\\.yaml$/"
      ],
      "matchStrings": [
        "https://github\\.com/(?<depName>[\\w.-]+/[\\w.-]+)/releases/download/(?<currentValue>v[\\d.]+)/",
        "https://raw\\.githubusercontent\\.com/(?<depName>[\\w.-]+/[\\w.-]+)/(?<currentValue>v[\\d.]+)/"
      ],
      "datasourceTemplate": "github-releases"
    }
  ]
}
