discovery.kubernetes "pods" {
	role = "pod"
}

discovery.relabel "pod_logs" {
	targets = discovery.kubernetes.pods.targets

	// eigene Logs nicht einsammeln (sonst Rückkopplung)
	rule {
		source_labels = ["__meta_kubernetes_pod_label_app_kubernetes_io_name"]
		regex         = "(alloy|vector)"
		action        = "drop"
	}

	rule {
		source_labels = ["__meta_kubernetes_namespace"]
		target_label  = "namespace"
	}

	rule {
		source_labels = ["__meta_kubernetes_pod_name"]
		target_label  = "pod"
	}

	rule {
		source_labels = ["__meta_kubernetes_pod_container_name"]
		target_label  = "container"
	}

	rule {
		source_labels = ["__meta_kubernetes_pod_label_app_kubernetes_io_name"]
		target_label  = "service"
	}

	rule {
		replacement  = "talos-homelab"
		target_label = "cluster"
	}
}

loki.source.kubernetes "pods" {
	targets    = discovery.relabel.pod_logs.output
	forward_to = [loki.process.drop_noise.receiver]
}

// entspricht filter_noise im vector-agent: Health-Endpunkte und
// kube-system raus, aber Tetragon und CoreDNS bleiben (SIEM)
loki.process "drop_noise" {
	stage.drop {
		expression = "GET /(healthz|readyz)"
	}

	forward_to = [loki.process.enrich.receiver]
}

loki.process "enrich" {
	stage.json {
		expressions = {
			level = "level",
		}
	}

	stage.labels {
		values = {
			level = "",
		}
	}

	forward_to = [loki.write.default.receiver]
}

// apiserver-Audit — nur auf Control-Plane-Nodes vorhanden
local.file_match "kube_audit" {
	path_targets = [{
		__path__ = "/var/log/audit/kube/kube-apiserver*.log",
		source   = "kube-audit",
		cluster  = "talos-homelab",
	}]
}

loki.source.file "kube_audit" {
	targets    = local.file_match.kube_audit.targets
	forward_to = [loki.write.default.receiver]
}

// Hubble — nur Verdicts, die zählen. FORWARDED/TRACED flutet sonst
// die Pipeline (ein Event pro TCP-Paket).
local.file_match "hubble" {
	path_targets = [{
		__path__ = "/var/run/cilium/hubble/events.log",
		source   = "hubble",
		cluster  = "talos-homelab",
	}]
}

loki.source.file "hubble" {
	targets    = local.file_match.hubble.targets
	forward_to = [loki.process.hubble_security.receiver]
}

loki.process "hubble_security" {
	stage.json {
		expressions = {
			verdict = "flow.verdict",
		}
	}

	stage.drop {
		source = "verdict"
		expression = "^(FORWARDED|TRACED|REDIRECTED)$"
	}

	stage.labels {
		values = {
			verdict = "",
		}
	}

	forward_to = [loki.write.default.receiver]
}

// Talos-Logs bleiben vorerst bei Vector: der einzige Alloy-Weg waere
// otelcol.receiver.tcplog, und der ist experimental. Dafuer den ganzen
// Agent auf --stability.level=experimental zu setzen, senkt die Huerde
// fuer JEDE kuenftige Komponente.

loki.write "default" {
	endpoint {
		url       = "http://loki-gateway.monitoring.svc.cluster.local:80/loki/api/v1/push"
		tenant_id = "talos-homelab"
	}
}
